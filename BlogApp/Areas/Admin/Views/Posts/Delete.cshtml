@model Blog.Domain.Entities.Post

@{
    ViewData["Title"] = "Details";
}

<div class="container px-4 py-5">
    <h2 class="pb-2 border-bottom">Deseas eliminar la publicacion?</h2>

    <div class="row row-cols-8 row-cols-md-8 align-items-md-center g-5 ">
        <div class="col d-flex flex-column align-items-center gap-2">
            <h2 class="fw-bold text-body-emphasis">@Html.DisplayFor(model => model.Title)</h2>
        </div>
    </div>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex align-items-center justify-content-center mt-5">
            <input type="submit" value="Eliminar" class="btn btn-danger mx-2" />
            <a asp-action="Index" class="btn btn-primary mx-2">Volver</a>
        </div>
    </form>
</div>
