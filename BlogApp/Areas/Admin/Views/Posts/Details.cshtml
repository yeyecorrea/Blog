@model Blog.Domain.Entities.Post

@{
    ViewData["Title"] = "Details";
}

<div class="container px-4 py-5">
    <h2 class="pb-2 border-bottom">Detalles de la publicacion</h2>

    <div class="row row-cols-8 row-cols-md-8 align-items-md-center g-5 py-5">
        <div class="col d-flex flex-column align-items-start gap-2">
            <h2 class="fw-bold text-body-emphasis">@Html.DisplayFor(model => model.Title)</h2>
            <p class="text-body-secondary">@Html.Raw(Model.Content)</p>

        </div>
    <div class="col">
        <div class="row row-cols-8 row-cols-sm-8 g-4">
            <div class="col d-flex flex-column gap-2">
                    <h4 class="fw-semibold mb-0 text-body-emphasis"><i class="ion-ios-albums"></i> @Html.DisplayNameFor(model => model.Slug) </h4>
                    <p class="text-body-secondary">@Html.DisplayFor(model => model.Slug)</p>
            </div>

            <div class="col d-flex flex-column gap-2">
                    <h4 class="fw-semibold mb-0 text-body-emphasis"><i class="ion-ios-calendar"></i> @Html.DisplayNameFor(model => model.DateCreated) </h4>
                    <p class="text-body-secondary">@Html.DisplayFor(model => model.DateCreated)</p>
            </div>

            <div class="col d-flex flex-column gap-2">
                    <h4 class="fw-semibold mb-0 text-body-emphasis"><i class="ion-ios-calendar"></i> @Html.DisplayNameFor(model => model.DateUpdated) </h4>
                    <p class="text-body-secondary">@Html.DisplayFor(model => model.DateUpdated)</p>
            </div>

            <div class="col d-flex flex-column gap-2">
                    <h4 class="fw-semibold mb-0 text-body-emphasis"> <i class="ion-person"></i> @Html.DisplayNameFor(model => model.User)</h4>
                    <p class="text-body-secondary">@Html.DisplayFor(model => model.User.Email)</p>
            </div>
            
                
        </div>
            <div class="d-flex align-items-center justify-content-center mt-5">
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary mx-2">Editar</a>
                <a asp-action="Index" class="btn btn-primary  mx-2">Volver</a>

            </div>
    </div>
</div>